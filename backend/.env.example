# IoT Honeypot Monitor Backend Configuration
# Copy this file to .env and adjust values as needed.

# Application
APP_NAME=iot-honeypot-backend
APP_VERSION=0.1.0
DEBUG=false

# Database (SQLite by default; change to PostgreSQL URL for production)
DATABASE_URL=sqlite:///./honeypot.db

# CORS - Allowed frontend origins (comma-separated)
# Add your frontend development server origin here
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Device status threshold in seconds
# Devices with no activity within this period are marked "inactive"
DEVICE_INACTIVE_THRESHOLD_SECONDS=300
