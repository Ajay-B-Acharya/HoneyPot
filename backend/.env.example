# IoT Honeypot Monitor Backend Configuration
# Copy this file to .env and adjust values as needed.

# Application
APP_NAME=iot-honeypot-backend
APP_VERSION=0.1.0
DEBUG=false

# Database (SQLite by default; change to PostgreSQL URL for production)
DATABASE_URL=sqlite:///./honeypot.db

# CORS - Allowed frontend origins (comma-separated)
# Add your frontend development server origin here
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Device status threshold in seconds
# Devices with no activity within this period are marked "inactive"
DEVICE_INACTIVE_THRESHOLD_SECONDS=300

# Security Detection Engine Configuration
# Comma-separated list of allowed HTTP endpoints (Rule R1)
DETECTION_ALLOWED_ENDPOINTS=/status,/info,/config

# High request rate detection settings (Rule R2)
DETECTION_RATE_THRESHOLD=20
DETECTION_RATE_WINDOW_SECONDS=10
DETECTION_RATE_COOLDOWN_SECONDS=10

# Repeated request detection settings (Rule R3)
DETECTION_REPEATED_THRESHOLD=10
DETECTION_REPEATED_WINDOW_SECONDS=10
DETECTION_REPEATED_COOLDOWN_SECONDS=10

# In-memory tracking limits and expiration (bounded prototype state)
DETECTION_MAX_TRACKING_ENTRIES=10000
DETECTION_TRACKING_EXPIRATION_SECONDS=60
