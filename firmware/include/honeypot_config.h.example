/*
 * IoT Honeypot Monitor — FRDM-RW612 Firmware Configuration Template
 *
 * Copy this file to honeypot_config.h and update with your local network settings.
 * DO NOT commit honeypot_config.h with real Wi-Fi credentials to public git.
 */

#ifndef HONEYPOT_CONFIG_H_
#define HONEYPOT_CONFIG_H_

/* --------------------------------------------------------------------------
 * Wi-Fi Access Point Settings
 * -------------------------------------------------------------------------- */
#ifndef HONEYPOT_WIFI_SSID
#define HONEYPOT_WIFI_SSID "Your_WiFi_SSID"
#endif

#ifndef HONEYPOT_WIFI_PASS
#define HONEYPOT_WIFI_PASS "Your_WiFi_Password"
#endif

#define HONEYPOT_WIFI_LABEL "rw612_honeypot_net"

/* --------------------------------------------------------------------------
 * Central Ingestion Backend (FastAPI) Target
 * Note: Use the workstation's reachable LAN IP (e.g., 10.78.184.199 or 192.168.x.x)
 * DO NOT use 127.0.0.1, as that would address the microcontroller itself.
 * -------------------------------------------------------------------------- */
#ifndef BACKEND_HOST_IP
#define BACKEND_HOST_IP "10.78.184.199"
#endif

#ifndef BACKEND_HOST_PORT
#define BACKEND_HOST_PORT 8000
#endif

/* --------------------------------------------------------------------------
 * Device Identity
 * -------------------------------------------------------------------------- */
#define HONEYPOT_DEVICE_ID   "rw612-security-01"
#define HONEYPOT_FW_VERSION  "1.0.0-rw612"
#define HONEYPOT_MODEL       "NXP FRDM-RW612"

/* --------------------------------------------------------------------------
 * Local Decoy Honeypot HTTP Server Port
 * -------------------------------------------------------------------------- */
#define HONEYPOT_HTTP_PORT   80

/* --------------------------------------------------------------------------
 * Edge Intrusion Detection Rules Configuration
 * -------------------------------------------------------------------------- */
/* Rule R2: Rate monitoring (max requests allowed in rolling window) */
#define EDGE_RATE_THRESHOLD        10
#define EDGE_RATE_WINDOW_MS        10000

/* Rule R3: Repeated probe monitoring (consecutive requests to same path) */
#define EDGE_REPEATED_THRESHOLD    5

/* Dispatcher Task Settings */
#define TELEMETRY_QUEUE_LENGTH     16
#define TELEMETRY_TIMEOUT_MS       5000
#define TELEMETRY_MAX_RETRIES      3

#endif /* HONEYPOT_CONFIG_H_ */
